# ============================================================
# Health_Manager .gitignore
# ============================================================

# 构建输出目录
build/

# IDE 与编辑器
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# 编译产物
*.o
*.obj
*.exe
*.out
*.app

# CMake 生成的缓存与中间文件
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
Makefile
*.cmake
!CMakeLists.txt

# 第三方依赖（通过 FetchContent 管理，无需提交）
third_party/_fetch/

# 打包产物
*.zip
*.tar.gz
*.dmg