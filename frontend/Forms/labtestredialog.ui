<?xml version="1.0" encoding="UTF-8"?>
<ui version="4.0">
 <class>LabTestReDialog</class>
 <widget class="QDialog" name="LabTestReDialog">
  <property name="geometry"><rect><x>0</x><y>0</y><width>440</width><height>440</height></rect></property>
  <property name="windowTitle"><string>临床检验记录</string></property>
  <property name="minimumSize"><size><width>400</width><height>400</height></size></property>
  <property name="styleSheet"><string>QLabel { color: #333; } QGroupBox { color: #333; }</string></property>
  <layout class="QVBoxLayout" name="mainLayout">
   <item><widget class="QGroupBox" name="timeGroup"><property name="title"><string>采样时间</string></property>
    <layout class="QHBoxLayout"><item><widget class="QDateTimeEdit" name="dateTimeEdit"><property name="calendarPopup"><bool>true</bool></property><property name="displayFormat"><string>yyyy-MM-dd HH:mm</string></property></widget></item></layout>
   </widget></item>
   <item><widget class="QGroupBox" name="dataGroup"><property name="title"><string>检验指标</string></property>
    <layout class="QFormLayout" name="formLayout">
     <property name="spacing"><number>10</number></property>
     <item row="0" column="0"><widget class="QLabel" name="label"><property name="text"><string>空腹血糖</string></property></widget></item>
     <item row="0" column="1"><widget class="QDoubleSpinBox" name="fastingGlucoseSpinBox"><property name="decimals"><number>2</number></property><property name="maximum"><double>100</double></property><property name="suffix"><string> mmol/L</string></property><property name="toolTip"><string notr="true">留空或为 0 表示不记录此项</string></property><property name="toolTip"><string>正常 3.9-6.1，≥7.0 需排查糖尿病</string></property></widget></item>
     <item row="1" column="0"><widget class="QLabel" name="label_3"><property name="text"><string>总胆固醇 TC</string></property></widget></item>
     <item row="1" column="1"><widget class="QDoubleSpinBox" name="totalCholesterolSpinBox"><property name="decimals"><number>2</number></property><property name="maximum"><double>100</double></property><property name="suffix"><string> mmol/L</string></property><property name="toolTip"><string notr="true">留空或为 0 表示不记录此项</string></property><property name="toolTip"><string>理想 &lt;5.2，边缘升高 5.2-6.2</string></property></widget></item>
     <item row="2" column="0"><widget class="QLabel" name="label_5"><property name="text"><string>LDL-C 坏胆固醇</string></property></widget></item>
     <item row="2" column="1"><widget class="QDoubleSpinBox" name="ldlSpinBox"><property name="decimals"><number>2</number></property><property name="maximum"><double>100</double></property><property name="suffix"><string> mmol/L</string></property><property name="toolTip"><string notr="true">留空或为 0 表示不记录此项</string></property><property name="toolTip"><string>理想 &lt;3.4，高危人群应 &lt;2.6</string></property></widget></item>
     <item row="3" column="0"><widget class="QLabel" name="label_7"><property name="text"><string>HDL-C 好胆固醇</string></property></widget></item>
     <item row="3" column="1"><widget class="QDoubleSpinBox" name="hdlSpinBox"><property name="decimals"><number>2</number></property><property name="maximum"><double>100</double></property><property name="suffix"><string> mmol/L</string></property><property name="toolTip"><string notr="true">留空或为 0 表示不记录此项</string></property><property name="toolTip"><string>男 ≥1.0，女 ≥1.3 为理想</string></property></widget></item>
     <item row="4" column="0"><widget class="QLabel" name="label_9"><property name="text"><string>甘油三酯 TG</string></property></widget></item>
     <item row="4" column="1"><widget class="QDoubleSpinBox" name="triglyceridesSpinBox"><property name="decimals"><number>2</number></property><property name="maximum"><double>100</double></property><property name="suffix"><string> mmol/L</string></property><property name="toolTip"><string notr="true">留空或为 0 表示不记录此项</string></property><property name="toolTip"><string>理想 &lt;1.7，升高 ≥1.7</string></property></widget></item>
     <item row="5" column="0"><widget class="QLabel" name="label_11"><property name="text"><string>血尿酸 UA</string></property></widget></item>
     <item row="5" column="1"><widget class="QDoubleSpinBox" name="uricAcidSpinBox"><property name="decimals"><number>0</number></property><property name="maximum"><double>3000</double></property><property name="suffix"><string> μmol/L</string></property><property name="toolTip"><string notr="true">留空或为 0 表示不记录此项</string></property><property name="toolTip"><string>男 &lt;420，女 &lt;360 μmol/L</string></property></widget></item>
    </layout>
   </widget></item>
   <item><widget class="QDialogButtonBox" name="buttonBox"><property name="standardButtons"><set>QDialogButtonBox::Ok|QDialogButtonBox::Cancel</set></property></widget></item>
  </layout>
 </widget>
 <resources/>
 <connections>
  <connection><sender>buttonBox</sender><signal>accepted()</signal><receiver>LabTestReDialog</receiver><slot>accept()</slot></connection>
  <connection><sender>buttonBox</sender><signal>rejected()</signal><receiver>LabTestReDialog</receiver><slot>reject()</slot></connection>
 </connections>
</ui>
